# DepositSafe environment separation
NODE_ENV=development
DATABASE_URL=

# Clerk provisions these values per environment. Do not commit real values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=

# Comma-separated administrator emails for non-Clerk role bootstrapping.
DEPOSITSAFE_ADMIN_EMAILS=
# Credas (server-side only). Keys are per environment; sandbox and production keys differ.
CREDAS_API_KEY=
# sandbox or production. Defaults to sandbox in development and production in a production runtime.
CREDAS_ENVIRONMENT=
# Journey and actor IDs from GET /journeys. Required in production; sandbox uses the public Credas IDs.
CREDAS_IDENTITY_JOURNEY_ID=
CREDAS_IDENTITY_ACTOR_ID=
CREDAS_RIGHT_TO_RENT_JOURNEY_ID=
CREDAS_RIGHT_TO_RENT_ACTOR_ID=
# Optional shared header Credas sends with each webhook (name cannot contain hyphens).
CREDAS_WEBHOOK_HEADER_NAME=
CREDAS_WEBHOOK_HEADER_VALUE=
# Set to true to buy the title register with each Property Ownership Check (chargeable).
CREDAS_LAND_REGISTRY_TITLE_REGISTER=
# Stripe, outside Replit only (on Replit the key comes from the Stripe connector).
# The key's mode must match the runtime: sk_test_ in development, sk_live_ in production.
# A live key is accepted only with the DepositSafe live account ID.
STRIPE_SECRET_KEY=
STRIPE_ACCOUNT_ID=
# Set to test to run a production runtime outside Replit against the Stripe sandbox (staging).
STRIPE_MODE=
# Public HTTPS origin of this app, used for Stripe and Credas webhooks.
DEPOSITSAFE_PUBLIC_ORIGIN=
# Directory of the built web app for the API to serve. Set by the Docker image; leave empty elsewhere.
DEPOSITSAFE_WEB_ROOT=
